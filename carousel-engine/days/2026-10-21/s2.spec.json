  {
   "type": "sheet",
   "title": "8. Excel ~365~ formulas",
   "ribbon": "Not in Excel 2016 or 2019",
   "rows": [
    {
     "name": "Each city once",
     "formula": "=UNIQUE(A2:A5)",
     "result": "Pune, Indore, Jaipur"
    },
    {
     "name": "Cities seen only once",
     "formula": "=UNIQUE(A2:A5,,TRUE)",
     "result": "Indore, Jaipur"
    },
    {
     "name": "Count distinct cities",
     "formula": "=ROWS(UNIQUE(A2:A5))",
     "result": "3"
    },
    {
     "name": "Sort by sales, high first",
     "formula": "=SORTBY(A2:C5,C2:C5,-1)",
     "result": "Indore 900, Pune 700..."
    },
    {
     "name": "Rows with sales over 500",
     "formula": "=FILTER(A2:C5,C2:C5>500)",
     "result": "Indore 900, Pune 700"
    },
    {
     "name": "Same, with a fallback",
     "formula": "=FILTER(A2:C5,C2:C5>5000,\"None\")",
     "result": "None"
    },
    {
     "name": "Two conditions (AND)",
     "formula": "=FILTER(A2:C5,(A2:A5=\"Pune\")*(C2:C5>500))",
     "result": "Pune, Neha, 700"
    },
    {
     "name": "Split at commas",
     "formula": "=TEXTSPLIT(D2,\",\")",
     "result": "Pune | Indore | Jaipur"
    },
    {
     "name": "Split, skip empty bits",
     "formula": "=TEXTSPLIT(D2,\",\",,TRUE)",
     "result": "Pune | Indore | Jaipur"
    }
   ],
   "data": "A = Pune, Indore, Pune, Jaipur | B = Asha, Ravi, Neha, Imran | C = 300, 900, 700, 200"
  },
