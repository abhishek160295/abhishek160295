   "title": "16. Errors and how to fix them",
   "cols": [
    "#",
    "Error",
    "What it usually means"
   ],
   "rows": [
    [
     "#N/A",
     "Lookup value not found. Check spaces, text vs number."
    ],
    [
     "#VALUE!",
     "Text where a number was expected."
    ],
    [
     "#REF!",
     "The formula points to a deleted cell."
    ],
    [
     "#DIV/0!",
     "Dividing by zero or a blank cell."
    ],
    [
     "#NAME?",
     "Misspelt function, missing quotes, or not in your version."
    ],
    [
     "#SPILL!",
     "A 365 formula has no room. Clear the cells below."
    ],
    [
     "#NUM!",
     "An impossible number, like a bad date sum."
    ],
    [
     "#####",
     "Column too narrow. Widen it."
    ],
    [
     "Total looks wrong",
     "Numbers stored as text. They sit on the left."
    ],
    [
     "VLOOKUP picks a wrong row",
     "Last argument missing. Use FALSE."
    ],
