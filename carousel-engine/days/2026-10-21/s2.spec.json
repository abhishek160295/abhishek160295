  {
   "type": "sheet",
   "title": "12. Conditional ~formatting~",
   "ribbon": "Rules that use a formula",
   "rows": [
    {
     "name": "Sales above 1000",
     "formula": "=$C2>1000"
    },
    {
     "name": "Pending orders",
     "formula": "=$D2=\"Pending\""
    },
    {
     "name": "Duplicates in column A",
     "formula": "=COUNTIF($A:$A,$A2)>1"
    },
    {
     "name": "Highest value",
     "formula": "=C2=MAX($C$2:$C$10)"
    },
    {
     "name": "Every other row",
     "formula": "=MOD(ROW(),2)=0"
    },
    {
     "name": "Overdue dates",
     "formula": "=$E2<TODAY()"
    },
    {
     "name": "Empty cells",
     "formula": "=ISBLANK($B2)"
    },
    {
     "name": "Between 500 and 999",
     "formula": "=AND($C2>=500,$C2<1000)"
    },
    {
     "name": "Weekend dates",
     "formula": "=WEEKDAY($E2,2)>5"
    },
    {
     "name": "Text contains delhi",
     "formula": "=ISNUMBER(SEARCH(\"delhi\",$F2))"
    }
