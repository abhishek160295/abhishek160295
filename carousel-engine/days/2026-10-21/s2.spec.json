    },
    {
     "name": "Remove line breaks",
     "formula": "=CLEAN(D2)"
    },
    {
     "name": "Count blank cells",
     "formula": "=COUNTBLANK(B2:B6)"
    },
    {
     "name": "Extra spaces hiding",
     "formula": "=LEN(F2)-LEN(TRIM(F2))"
