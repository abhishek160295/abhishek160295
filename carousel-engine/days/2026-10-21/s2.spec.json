  {
   "type": "sheet",
   "title": "1. Cell ~references~",
   "ribbon": "The base of every formula",
   "rows": [
    {
     "name": "Multiply two cells",
     "formula": "=A2*B2"
    },
    {
     "name": "Lock a cell with $",
     "formula": "=A2*$B$1"
    },
    {
     "name": "Lock only the row",
     "formula": "=A2*B$1"
    },
    {
     "name": "Add a range",
     "formula": "=SUM(B2:B6)"
    },
    {
     "name": "Average",
     "formula": "=AVERAGE(B2:B6)"
    },
    {
     "name": "Largest value",
     "formula": "=MAX(B2:B6)"
    },
    {
     "name": "Count numbers only",
     "formula": "=COUNT(A2:A6)"
    },
    {
     "name": "Count filled cells",
     "formula": "=COUNTA(A2:A6)"
    },
    {
     "name": "Round to 2 places",
     "formula": "=ROUND(A2,2)"
    },
    {
     "name": "Always round up",
     "formula": "=ROUNDUP(A2,0)"
    }
   ]
  },
  {
   "type": "sheet",
   "title": "2. ~IF~ logic",
   "ribbon": "Let Excel decide",
   "rows": [
    {
     "name": "Pass or fail",
     "formula": "=IF(B2>=40,\"Pass\",\"Fail\")"
    },
    {
     "name": "Grade with nested IF",
     "formula": "=IF(B2>=75,\"A\",IF(B2>=60,\"B\",\"C\"))"
    },
    {
     "name": "Same grade with IFS",
     "formula": "=IFS(B2>=75,\"A\",B2>=60,\"B\",TRUE,\"C\")"
    },
    {
     "name": "Both must be true",
     "formula": "=IF(AND(B2>=40,C2>=75),\"Eligible\",\"No\")"
    },
    {
     "name": "Any one true",
     "formula": "=IF(OR(D2=\"Delivered\",D2=\"Closed\"),\"Done\",\"Open\")"
    },
    {
     "name": "Is the cell empty?",
     "formula": "=IF(ISBLANK(E2),\"Missing\",\"Filled\")"
    },
    {
     "name": "Hide errors",
     "formula": "=IFERROR(A2/B2,0)"
    },
    {
     "name": "Only hide #N/A",
     "formula": "=IFNA(MATCH(\"Z\",A2:A4,0),\"Not found\")"
    },
    {
     "name": "Codes to names",
     "formula": "=SWITCH(F2,\"N\",\"North\",\"S\",\"South\",\"Other\")"
    }
   ]
  },
  {
   "type": "sheet",
   "title": "3. Sum with ~conditions~",
   "ribbon": "SUMIFS runs half of MIS",
   "rows": [
    {
     "name": "Count one region",
     "formula": "=COUNTIF(A2:A7,\"North\")"
    },
    {
     "name": "Count with 2 conditions",
     "formula": "=COUNTIFS(A2:A7,\"North\",C2:C7,\"Closed\")"
    },
    {
     "name": "Sum one region",
     "formula": "=SUMIF(A2:A7,\"South\",B2:B7)"
    },
    {
     "name": "Sum with 2 conditions",
     "formula": "=SUMIFS(B2:B7,A2:A7,\"North\",C2:C7,\"Closed\")"
    },
    {
     "name": "Sum values above 250",
     "formula": "=SUMIF(B2:B7,\">250\")"
    },
    {
     "name": "Average one region",
     "formula": "=AVERAGEIF(A2:A7,\"North\",B2:B7)"
    },
    {
     "name": "Biggest sale in South",
     "formula": "=MAXIFS(B2:B7,A2:A7,\"South\")"
    },
    {
     "name": "Smallest open sale",
     "formula": "=MINIFS(B2:B7,C2:C7,\"Open\")"
    },
    {
     "name": "Count not closed",
     "formula": "=COUNTIF(C2:C7,\"<>Closed\")"
    },
    {
     "name": "Price x qty, summed",
     "formula": "=SUMPRODUCT(B2:B7,D2:D7)"
    }
   ]
  },
  {
   "type": "sheet",
   "title": "4. ~Lookups~",
   "ribbon": "VLOOKUP to XLOOKUP",
   "rows": [
    {
     "name": "Exact match",
     "formula": "=VLOOKUP(E2,A2:C4,2,FALSE)"
    },
    {
     "name": "Third column",
     "formula": "=VLOOKUP(E2,A2:C4,3,0)"
    },
    {
     "name": "Find a band (slab)",
     "formula": "=VLOOKUP(G2,H2:I4,2,TRUE)"
    },
    {
     "name": "Position in a list",
     "formula": "=MATCH(E2,A2:A4,0)"
    },
    {
     "name": "Value at a position",
     "formula": "=INDEX(B2:B4,2)"
    },
    {
     "name": "INDEX + MATCH",
     "formula": "=INDEX(B2:B4,MATCH(E2,A2:A4,0))"
    },
    {
     "name": "Look to the left",
     "formula": "=INDEX(A2:A4,MATCH(\"Neha\",B2:B4,0))"
    },
    {
     "name": "XLOOKUP (Excel 365)",
     "formula": "=XLOOKUP(E2,A2:A4,B2:B4)"
    },
    {
     "name": "With a not-found value",
     "formula": "=XLOOKUP(999,A2:A4,B2:B4,\"Not found\")"
    },
    {
     "name": "Last match, not first",
     "formula": "=XLOOKUP(E2,A2:A5,B2:B5,,0,-1)"
    }
   ]
  },
  {
   "type": "sheet",
   "title": "5. Clean ~text~",
   "ribbon": "Messy names, fixed",
   "rows": [
    {
     "name": "Remove extra spaces",
     "formula": "=TRIM(A2)"
    },
    {
     "name": "Proper case",
     "formula": "=PROPER(TRIM(A2))"
    },
    {
     "name": "Capital letters",
     "formula": "=UPPER(B2)"
    },
    {
     "name": "Small letters",
     "formula": "=LOWER(B2)"
    },
    {
     "name": "First 3 characters",
     "formula": "=LEFT(C2,3)"
    },
    {
     "name": "Last 4 characters",
     "formula": "=RIGHT(C2,4)"
    },
    {
     "name": "From the middle",
     "formula": "=MID(C2,5,2)"
    },
    {
     "name": "Length",
     "formula": "=LEN(C2)"
    },
    {
     "name": "Position of a dash",
     "formula": "=FIND(\"-\",C2)"
    },
    {
     "name": "Remove dashes",
     "formula": "=SUBSTITUTE(D2,\"-\",\"\")"
    }
   ]
  },
  {
   "type": "sheet",
   "title": "6. Join and ~split~",
   "ribbon": "Names, emails, labels",
   "rows": [
    {
     "name": "Join with a space",
     "formula": "=A2&\" \"&B2"
    },
    {
     "name": "Same with CONCAT",
     "formula": "=CONCAT(A2,\" \",B2)"
    },
    {
     "name": "Join a list, skip blanks",
     "formula": "=TEXTJOIN(\", \",TRUE,A2:A4)"
    },
    {
     "name": "Name before the @",
     "formula": "=LEFT(C2,FIND(\"@\",C2)-1)"
    },
    {
     "name": "Domain after the @",
     "formula": "=MID(C2,FIND(\"@\",C2)+1,50)"
    },
    {
     "name": "Text to number",
     "formula": "=VALUE(E2)"
    },
    {
     "name": "Show as percent",
     "formula": "=TEXT(F2,\"0.0%\")"
    },
    {
     "name": "Show a date your way",
     "formula": "=TEXT(G2,\"dd-mmm-yyyy\")"
    },
    {
     "name": "Repeat a character",
     "formula": "=REPT(\"*\",H2)"
    }
   ]
  },
  {
   "type": "sheet",
   "title": "7. ~Dates~",
   "ribbon": "Reports run on dates",
