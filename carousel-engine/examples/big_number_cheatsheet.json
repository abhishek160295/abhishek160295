{"format": "mega", "layout": "editorial", "series": "SQL", "slides": [{"sub": "10 queries + 20 'how do I' answers", "title": "The Only<br>SQL Cheat Sheet<br>You Need", "type": "marker_cover"}, {"ribbon": "10 queries you write every week", "rows": [{"formula": "SELECT * FROM orders WHERE amount > 500;", "name": "WHERE"}, {"formula": "SELECT * FROM orders ORDER BY amount DESC LIMIT 5;", "name": "ORDER BY + LIMIT"}, {"formula": "SELECT city, COUNT(*) FROM users GROUP BY city;", "name": "GROUP BY"}, {"formula": "... GROUP BY city HAVING COUNT(*) > 10;", "name": "HAVING"}, {"formula": "SELECT * FROM orders o JOIN users u ON o.user_id = u.id;", "name": "JOIN"}, {"formula": "SELECT DISTINCT city FROM users;", "name": "DISTINCT"}, {"formula": "SELECT COALESCE(phone, 'NA') FROM users;", "name": "COALESCE"}, {"formula": "CASE WHEN amount > 1000 THEN 'High' ELSE 'Low' END", "name": "CASE WHEN"}, {"formula": "RANK() OVER (ORDER BY salary DESC)", "name": "RANK()"}, {"formula": "SUM(amount) OVER (ORDER BY order_date)", "name": "Running total"}], "title": "SQL", "type": "sheet"}, {"cols": ["#", "How do I...", "SQL"], "rows": [["Count unique customers", "COUNT(DISTINCT customer_id)"], ["Find customers who never ordered", "LEFT JOIN orders o ... WHERE o.id IS NULL"], ["Find duplicate emails", "GROUP BY email HAVING COUNT(*) > 1"], ["Get the 2nd highest salary", "DENSE_RANK() OVER (ORDER BY salary DESC), keep rank 2"], ["Top 3 per department", "ROW_NUMBER() OVER (PARTITION BY dept ORDER BY salary DESC) <= 3"], ["Previous month's value", "LAG(sales) OVER (ORDER BY month)"], ["Month-on-month change", "sales - LAG(sales) OVER (ORDER BY month)"], ["Search text in a column", "WHERE name LIKE '%kumar%'"], ["Match a list of values", "WHERE city IN ('Pune', 'Indore')"], ["Filter a date range", "dt >= '2026-01-01' AND dt < '2026-04-01'"], ["Replace NULL with 0", "COALESCE(amount, 0)"], ["Avoid divide by zero", "amount / NULLIF(qty, 0)"], ["Pull the year from a date", "EXTRACT(YEAR FROM order_date)"], ["Join two text columns", "CONCAT(first_name, ' ', last_name)"], ["Stack two tables", "UNION ALL (keeps duplicates)"], ["Check if related rows exist", "WHERE EXISTS (SELECT 1 FROM ...)"], ["Reuse a subquery", "WITH t AS (SELECT ...) SELECT * FROM t"], ["Percent of total", "amount * 100.0 / SUM(amount) OVER ()"], ["Round to 2 decimals", "ROUND(avg_price, 2)"], ["Count with a condition", "SUM(CASE WHEN status = 'Paid' THEN 1 ELSE 0 END)"]], "title": "SQL: how do I...", "type": "bigtable"}, {"action": "Follow @thedataguy16", "body": "Comment SQLSHEET and I'll DM you this SQL cheat sheet as a PDF.", "keyword": "SQLSHEET", "title": "Save it.<br>Use it ~weekly~.", "type": "cta"}], "style": "paper"}